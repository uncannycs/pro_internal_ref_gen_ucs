<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_normal_form_view_inherit_ref_gen" model="ir.ui.view">
        <field name="name">product.normal.form.view.inherit.ref.gen</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_internal_reference" string="Generate Internal Ref" type="object" class="btn-secondary" help="Generate internal reference code for this variant"/>
            </xpath>
        </field>
    </record>

    <!-- Server Action for Multi-Select in Product Variants List View -->
    <record id="action_generate_variant_internal_ref_server" model="ir.actions.server">
        <field name="name">Generate Internal Reference</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
records.action_generate_internal_reference()
        </field>
    </record>
</odoo>
