<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_ref_gen" model="ir.ui.view">
        <field name="name">product.template.form.view.inherit.ref.gen</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_generate_internal_reference" string="Generate Internal Ref" type="object" class="btn-secondary" help="Generate internal reference code for this product"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="auto_generate_code"/>
            </xpath>
        </field>
    </record>

    <!-- Server Action for Multi-Select in Product Templates List View -->
    <record id="action_generate_template_internal_ref_server" model="ir.actions.server">
        <field name="name">Generate Internal Reference</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
records.action_generate_internal_reference()
        </field>
    </record>
</odoo>
